{
  "name": "@squirtles331/vue3-plugin-print",
  "version": "0.2.0",
  "type": "module",
  "description": "An embeddable Vue 3 visual print-template designer for browser-native printing.",
  "license": "MIT",
  "keywords": [
    "vue",
    "print",
    "print-template",
    "template-designer",
    "browser-printing"
  ],
  "author": {
    "name": "songTongxue",
    "email": "2644648810@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Squirtles331/vue3-plugin-print.git"
  },
  "bugs": {
    "url": "https://github.com/Squirtles331/vue3-plugin-print/issues"
  },
  "homepage": "https://squirtles331.github.io/vue3-plugin-print/",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run build:library",
    "build:library": "npm run typecheck && vite build --config vite.lib.config.ts && vue-tsc --project tsconfig.build.json",
    "build:demo": "npm run typecheck && vite build --config vite.config.ts",
    "docs:dev": "tsx scripts/vitepress.ts dev",
    "docs:build": "tsx scripts/vitepress.ts build",
    "docs:preview": "tsx scripts/vitepress.ts preview",
    "pages:build": "tsx scripts/build-pages.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"test/**/*.ts\" \"scripts/**/*.{ts,mts}\" \"docs/.vitepress/**/*.ts\" \"*.{ts,cts}\"",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:performance": "vitest run test/performance.test.ts",
    "test:pages-build": "tsx scripts/verify-github-pages-build.ts",
    "test:package": "tsx scripts/verify-package-artifact.ts",
    "test:consumer": "tsx scripts/verify-packed-consumer.ts",
    "verify:release-tag": "tsx scripts/verify-release-tag.ts",
    "verify": "tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2",
    "jsbarcode": "^3.11.6",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "sass": "^1.85.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.12"
  }
}
