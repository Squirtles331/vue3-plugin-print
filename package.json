{
  "name": "@squirtles331/vue3-plugin-print",
  "version": "0.1.0",
  "type": "module",
  "description": "An embeddable Vue 3 visual print-template designer for browser-native printing.",
  "license": "MIT",
  "keywords": [
    "vue",
    "print",
    "print-template",
    "template-designer",
    "browser-printing"
  ],
  "author": {
    "name": "songTongxue",
    "email": "2644648810@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Squirtles331/vue3-plugin-print.git"
  },
  "bugs": {
    "url": "https://github.com/Squirtles331/vue3-plugin-print/issues"
  },
  "homepage": "https://squirtles331.github.io/vue3-plugin-print/",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library",
    "build:library": "vite build --config vite.lib.config.js && node scripts/copy-library-types.mjs",
    "build:demo": "vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "pages:build": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,vue}\" \"test/**/*.js\" \"scripts/**/*.mjs\" \"vite.config.js\" \"vite.lib.config.js\"",
    "test": "vitest run",
    "test:performance": "vitest run test/performance.test.js",
    "test:pages-build": "node scripts/verify-github-pages-build.mjs",
    "test:package": "node scripts/verify-package-artifact.mjs",
    "test:consumer": "node scripts/verify-packed-consumer.mjs",
    "verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2",
    "jsbarcode": "^3.11.6",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "sass": "^1.85.1",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4",
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.6",
    "vue": "^3.5.13",
    "vitest": "^3.2.4"
  }
}
